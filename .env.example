# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Both variables are required. prisma/schema.prisma declares `url` AND `directUrl`,
# so `prisma generate` — the first half of `npm run build` — fails with error P1012
# ("You must provide a nonempty direct URL") if DIRECT_URL is missing or empty.
# Set BOTH in every environment, including each Vercel environment
# (Production, Preview and Development), not just locally.

# Pooled connection (PgBouncer — the "-pooler" host). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require"

# Direct/unpooled connection (same host WITHOUT "-pooler").
# Used by Prisma for schema operations such as `prisma db push` and `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Admin Seed ──────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@wajid-arya.com"
ADMIN_PASSWORD="ChangeMe@2025!"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Wajid Ali Arya"
